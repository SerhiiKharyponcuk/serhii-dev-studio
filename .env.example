# Web
VITE_API_URL=http://localhost:4000/api
VITE_SITE_URL=http://localhost:5173

# API
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/serhii_dev_studio
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
SETTINGS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Serhii Dev Studio <no-reply@example.com>

# File storage: use local only for development; configure s3 for production.
FILE_STORAGE=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=
